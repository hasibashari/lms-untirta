generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String
  name            String
  role            Role            @default(MAHASISWA)
  createdAt       DateTime        @default(now())
  advisorId       String?
  isDospem        Boolean         @default(false)
  isEmailVerified Boolean         @default(true)
  emailVerifiedAt DateTime?
  nim             String?         @unique
  classesTeaching Class[]         @relation("LecturerClasses")
  coursesTeaching Course[]        @relation("TeacherCourses")
  gradesGiven     FinalGrade[]    @relation("LecturerGrades")
  finalGrades     FinalGrade[]    @relation("StudentGrades")
  forumReplies    ForumReply[]    @relation("ReplyAuthor")
  forumThreads    ForumThread[]   @relation("ThreadAuthor")
  krsEnrollments  KrsEnrollment[]
  submissions     Submission[]
  advisor         User?           @relation("AdvisorStudents", fields: [advisorId], references: [id])
  advisedStudents User[]          @relation("AdvisorStudents")

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([role])
  @@index([advisorId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}


model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}


model Course {
  id           String        @id @default(uuid())
  title        String
  description  String?
  code         String        @unique
  teacherId    String
  createdAt    DateTime      @default(now())
  semester     Int?
  sks          Int           @default(3)
  assignments  Assignment[]
  classes      Class[]
  teacher      User          @relation("TeacherCourses", fields: [teacherId], references: [id])
  materials    Material[]
}

model Material {
  id          String   @id @default(uuid())
  title       String
  content     String?
  courseId    String
  classId     String?
  createdAt   DateTime @default(now())
  fileUrl     String?
  isPublished Boolean  @default(true)
  order       Int      @default(1)
  updatedAt   DateTime @updatedAt
  videoUrl    String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([classId])
}

model Assignment {
  id          String       @id @default(uuid())
  title       String
  dueDate     DateTime
  courseId    String
  classId     String?
  createdAt   DateTime     @default(now())
  description String?
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([courseId])
  @@index([classId])
}

model Submission {
  id           String     @id @default(uuid())
  fileUrl      String?
  note         String?
  grade        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model Class {
  id                 String           @id @default(uuid())
  courseId           String
  lecturerId         String
  section            String
  schedule           String?
  room               String?
  capacity           Int              @default(40)
  isEnrollmentOpen   Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicSemesterId String
  academicSemester   AcademicSemester @relation(fields: [academicSemesterId], references: [id])
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer           User             @relation("LecturerClasses", fields: [lecturerId], references: [id])
  finalGrades        FinalGrade[]
  krsEnrollments     KrsEnrollment[]
  assignments        Assignment[]
  materials          Material[]
  forumThreads       ForumThread[]

  @@unique([courseId, academicSemesterId, section])
  @@index([lecturerId])
  @@index([courseId])
  @@index([academicSemesterId])
}

model KrsEnrollment {
  id            String           @id @default(uuid())
  studentId     String
  classId       String
  status        KrsStatus        @default(PENDING)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  approvedAt    DateTime?
  approvedBy    String?
  submittedAt   DateTime?
  revisionCount Int              @default(0)
  approvalLogs  KrsApprovalLog[]
  class         Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model AcademicSemester {
  id           String         @id @default(uuid())
  academicYear String
  semesterType SemesterType
  status       SemesterStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  maxSks       Int            @default(24)
  isAutoKrs    Boolean        @default(true)
  classes      Class[]
  finalGrades  FinalGrade[]

  @@unique([academicYear, semesterType])
}

model FinalGrade {
  id                 String           @id @default(uuid())
  studentId          String
  classId            String
  academicSemesterId String
  lecturerId         String
  letterGrade        String
  gradePoint         Float
  numericScore       Float?
  status             GradeStatus      @default(DRAFT)
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicSemester   AcademicSemester @relation(fields: [academicSemesterId], references: [id])
  class              Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  lecturer           User             @relation("LecturerGrades", fields: [lecturerId], references: [id])
  student            User             @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([academicSemesterId])
  @@index([lecturerId])
}

model KrsApprovalLog {
  id           String        @id @default(uuid())
  enrollmentId String
  fromStatus   KrsStatus
  toStatus     KrsStatus
  actorId      String?
  actorType    String
  note         String?
  createdAt    DateTime      @default(now())
  enrollment   KrsEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id        String       @id @default(uuid())
  title     String
  content   String
  isPinned  Boolean      @default(false)
  classId   String
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  replies   ForumReply[]
  author    User         @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  class     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([authorId])
}

model ForumReply {
  id        String       @id @default(uuid())
  content   String
  threadId  String
  authorId  String
  parentId  String? // Menambahkan parentId untuk nested replies
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent    ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumReply[] @relation("ReplyToReply")

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

enum Role {
  ADMIN
  DOSEN
  MAHASISWA
}

enum SemesterType {
  GANJIL
  GENAP
}

enum KrsStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SemesterStatus {
  DRAFT
  OPEN
  CLOSED
}

enum GradeStatus {
  DRAFT
  FINALIZED
}
