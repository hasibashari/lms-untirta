# Test database — served by docker-compose.test.yml on port 5433
# to avoid conflicts with any local dev PostgreSQL on 5432.
DATABASE_URL="postgresql://test_user:test_password@localhost:5433/lms_db_test?schema=public"

JWT_SECRET="test-jwt-secret-key-for-testing-only"

PORT=3001

# Redis is NOT required for tests.
# The auth middleware checks redisClient.isOpen and falls back to DB.
# Set a dummy URL so the module loads without errors.
REDIS_URL=""
